{
  "manifest_version": 3,
  "name": "Xpert",
  "description": "Mute accounts on X with one click, undo accidental mutes, and manage bulk queues and a local mute ledger.",
  "version": "0.2.4",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Xpert",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "css": [
        "src/content/content.css"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/storage.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
